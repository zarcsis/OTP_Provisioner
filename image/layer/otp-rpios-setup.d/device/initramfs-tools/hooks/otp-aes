#!/bin/sh
# initramfs-tools hook of the OTP provisioning station (image layer otp-rpios-setup): the bit-sliced NEON AES
# module that scripts/init-top/otp-aes loads on a CPU without the ARMv8 AES instructions (Compute Module 4).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

if modinfo -k "$version" aes-neon-bs >/dev/null 2>&1; then
    manual_add_modules aes-neon-bs
fi
