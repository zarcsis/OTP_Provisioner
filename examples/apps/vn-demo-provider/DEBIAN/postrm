#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = remove ]; then
    deb-systemd-helper mask vn-demo-provider.service >/dev/null || true
fi
if [ "$1" = purge ]; then
    deb-systemd-helper purge vn-demo-provider.service >/dev/null || true
    deb-systemd-helper unmask vn-demo-provider.service >/dev/null || true
fi
exit 0
