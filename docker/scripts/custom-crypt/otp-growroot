#!/bin/sh
# otp-growroot - grow the encrypted root to the whole storage device, once. Installed by the OTP
# provisioning station (otp-growroot.service).
#
# A board flashed by the station (fastboot IDP) already has a root partition up to the end of the card; a
# board flashed from the station's image file with Raspberry Pi Imager has the partition the file had, and
# the initramfs script otp-growpart grows it before the container is opened. Either way the LUKS2 mapping
# then fills the partition and only the ext4 file system inside is as small as the image. Steps: the root
# partition up to the end of the disk (when it is the last partition and the initramfs did not), the
# dm-crypt mapping up to the end of the partition (only when it ends before it: cryptsetup resize needs the
# passphrase even for nothing to do, and after the unlock the station image locks the firmware HMAC the
# keyscript needs), the ext4 file system up to the end of the mapping (resize2fs, online). Done once:
# /var/lib/otp-station/root-grown.
set -eu

DONE=/var/lib/otp-station/root-grown
log() { echo "otp-growroot: $*"; }
finish() { mkdir -p "${DONE%/*}"; : > "$DONE"; exit 0; }

# The root's device mapper name. findmnt names the root as fstab does: /dev/mapper/<name> (custom images) or
# /dev/disk/by-slot/system (the station image, a link to /dev/dm-N); both resolve to dm-N, whose name sysfs knows.
src=$(findmnt -n -o SOURCE /)
dev=$(readlink -f "$src" 2>/dev/null || echo "$src")
dm=$(basename "$dev")
name=
case "$dm" in
    dm-*) name=$(cat "/sys/class/block/$dm/dm/name" 2>/dev/null || true) ;;
esac
if [ -z "$name" ] || ! cryptsetup status "$name" >/dev/null 2>&1; then
    log "the root file system is on $src, not on a dm-crypt mapping: nothing to do"
    finish
fi
part=$(cryptsetup status "$name" | awk '$1 == "device:" { print $2 }')
[ -b "$part" ] || { log "cannot find the device under $name"; exit 1; }
pname=$(basename "$(readlink -f "$part")")

# 1. The partition, when the card is larger than the image and nothing follows the root partition.
if [ -e "/sys/class/block/$pname/partition" ]; then
    disk=$(basename "$(readlink -f "/sys/class/block/$pname/..")")
    num=$(cat "/sys/class/block/$pname/partition")
    start=$(cat "/sys/class/block/$pname/start")
    size=$(cat "/sys/class/block/$pname/size")
    total=$(cat "/sys/class/block/$disk/size")
    label=$(sfdisk --dump "/dev/$disk" 2>/dev/null | awk -F': *' '$1 == "label" { print $2 }')
    last=$total
    if [ "$label" = gpt ]; then
        sfdisk --relocate gpt-bak-std "/dev/$disk" >/dev/null 2>&1 || true
        last=$((total - 33))
    fi
    later=0
    for p in /sys/class/block/"$disk"/"$disk"*; do
        [ -e "$p/start" ] || continue
        [ "$(cat "$p/start")" -gt "$start" ] && later=1
    done
    want=$(( (last - start) / 2048 * 2048 ))
    if [ "$later" = 0 ] && [ "$want" -gt "$size" ]; then
        log "partition $num of /dev/$disk: $size -> $want sectors"
        echo "$start,$want" | sfdisk --no-reread --no-tell-kernel -N "$num" "/dev/$disk" >/dev/null
        # partx is in util-linux; resizepart in util-linux-extra, which Raspberry Pi OS Lite does not install
        partx -u -n "$num" "/dev/$disk" 2>/dev/null || resizepart "/dev/$disk" "$num" "$want"
    fi
fi

# 2. The dm-crypt mapping, when it ends before the partition does (offset and size in 512-byte sectors). A
#    mapping is a whole number of the container's sectors (4096 bytes = 8 of 512), so the last 1-7 sectors of a
#    partition whose size past the offset is not a multiple of that are left out even at full size: they do
#    not count, or a mapping that cannot grow would be resized (it needs the key) at every boot.
psize=$(cat "/sys/class/block/$pname/size")
moff=$(cryptsetup status "$name" | awk '$1 == "offset:" { print $2 }')
msize=$(cryptsetup status "$name" | awk '$1 == "size:" { print $2 }')
ssize=$(cryptsetup status "$name" | awk '$1 == "sector" && $2 == "size:" { print $3 }')
unit=$(( ${ssize:-512} / 512 ))
[ "$unit" -ge 1 ] || unit=1
mwant=$(( (psize - moff) / unit * unit ))
if [ "$mwant" -gt "$msize" ]; then
    log "mapping $name: $msize -> $mwant sectors"
    if ! cryptsetup resize "$name" </dev/null 2>/dev/null; then
        ks=$(awk -v n="$name" '$1 == n { print $4 }' /etc/crypttab | tr ',' '\n' | sed -n 's/^keyscript=//p')
        [ -n "$ks" ] && [ -x "$ks" ] || { log "cryptsetup resize needs the passphrase and /etc/crypttab names no keyscript"; exit 1; }
        CRYPTTAB_NAME=$name CRYPTTAB_SOURCE=$part "$ks" | cryptsetup resize --key-file=- "$name" \
            || { log "the mapping cannot grow without the key (the firmware HMAC is locked after the unlock)"; exit 1; }
    fi
fi

# 3. The file system.
resize2fs "$dev"
log "done: $(df -h / | awk 'NR == 2 { print $2 }') root file system"
finish
