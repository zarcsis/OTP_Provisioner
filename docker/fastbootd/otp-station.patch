+    // A bare kernel block device name ("mmcblk0p2"): no path, no "..", nothing under /dev/mapper.
+    static bool IsPlainBlockDeviceName(const std::string& name) {
+        if (name.empty() || name.size() > 32) {
+            return false;
+        }
