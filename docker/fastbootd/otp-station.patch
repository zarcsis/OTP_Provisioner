diff --git a/fastboot/device/crypto_native.cpp b/fastboot/device/crypto_native.cpp
index 90f9245..3956c75 100644
--- a/fastboot/device/crypto_native.cpp
+++ b/fastboot/device/crypto_native.cpp
@@ -84,6 +84,35 @@ bool CryptInitNative(const std::string& device_path, const std::string& label,
     return CryptInitNative(device_path, params, key_data, error_msg);
 }
 
+bool CryptCheckNative(const std::string& device_path, const std::string& key_data, int* slot,
+                      std::string* error_msg) {
+    struct crypt_device *cd = NULL;
+
+    int r = crypt_init(&cd, device_path.c_str());
+    if (r < 0) {
+        *error_msg = "Failed to initialize crypt device: " + std::string(strerror(-r));
+        return false;
+    }
+
+    r = crypt_load(cd, CRYPT_LUKS, NULL);
+    if (r < 0) {
+        *error_msg = "Failed to load LUKS header: " + std::string(strerror(-r));
+        crypt_free(cd);
+        return false;
+    }
+
+    // name == NULL: libcryptsetup only checks the passphrase and activates nothing.
+    r = crypt_activate_by_passphrase(cd, NULL, CRYPT_ANY_SLOT,
+                                     key_data.c_str(), key_data.size(), 0);
+    crypt_free(cd);
+    if (r < 0) {
+        *error_msg = "Key does not open the LUKS header: " + std::string(strerror(-r));
+        return false;
+    }
+    *slot = r;
+    return true;
+}
