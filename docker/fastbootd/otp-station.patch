+        bool ok = CryptCheckNative(block_device, luks_key, &slot, &error_msg);
+        OPENSSL_cleanse(luks_key.data(), luks_key.size());
+        if (!ok) {
+            return device->WriteFail("cryptcheck " + block_device + ": " + error_msg);
